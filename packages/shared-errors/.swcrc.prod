{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "target": "es2022",
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "keepClassNames": true,
    "externalHelpers": true,
    "loose": true,
    "minify": {
      "compress": {
        "unused": true,
        "dead_code": true,
        "keep_classnames": true,
        "keep_fnames": true,
        "passes": 2,
        "evaluate": true,
        "loops": true,
        "toplevel": true
      },
      "mangle": {
        "keep_classnames": true,
        "keep_fnames": true,
        "toplevel": true
      }
    }
  },
  "module": {
    "type": "es6"
  },
  "minify": true,
  "sourceMaps": false,
  "exclude": [
    "jest.config.[ct]s",
    ".*\\.spec.tsx?$",
    ".*\\.test.tsx?$",
    "./src/jest-setup.ts$",
    "./**/jest-setup.ts$",
    ".*.js$"
  ]
}

{
  "$schema": "https://raw.githubusercontent.com/nrwl/nx/master/packages/nx/schemas/project-schema.json",
  "name": "@clarte/shared-contracts",
  "root": "packages/shared-contracts",
  "projectType": "library",
  "tags": ["scope:shared-contracts", "type:lib"],
  "sourceRoot": "packages/shared-contracts/src",
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["^build"],
      "options": {
        "outputPath": "packages/shared-contracts/dist",
        "main": "packages/shared-contracts/src/index.ts",
        "tsConfig": "packages/shared-contracts/tsconfig.lib.json",
        "skipTypeCheck": true,
        "stripLeadingPaths": true,
        "clean": false
      }
    },
    "proto:generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/src/ports/proto/**/*.proto"],
      "outputs": ["{projectRoot}/src/ports/proto-types"],
      "options": {
        "command": "mkdir -p packages/shared-contracts/src/ports/proto-types && find . -name \"*.proto\" -not -path \"*/node_modules/*\" | while read -r f; do pnpm exec protoc -I=$(dirname \"$f\") -I=. --ts_proto_out=packages/shared-contracts/src/ports/proto-types --ts_proto_opt=nestJs=true,unwrapEmpty=true,importSuffix=.js \"$(basename \"$f\")\"; done",
        "cwd": "."
      }
    }
  }
}

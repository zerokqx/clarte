{
  "$schema": "https://json-schema.org/schema",
  "$id": "cqrs-command",
  "title": "CQRS Command Generator",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Имя команды (например, CreateUser)",
      "x-prompt": "Как будет называться команда?"
    },
    "projectName": {
      "type": "string",
      "description": "Имя проекта"
    }
  },
  "required": ["name", "projectName"]
}

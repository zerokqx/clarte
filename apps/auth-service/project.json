{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@clarte/auth-service",
  "root": "apps/auth-service",
  "projectType": "application",
  "tags": ["scope:auth", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "generate-keys"],
      "options": {
        "command": "webpack-cli build",
        "args": ["--mode=production"],
        "cwd": "apps/auth-service"
      },
      "configurations": {
        "development": {
          "args": ["--mode=development"]
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/apps/auth-service/dist/package.json",
        "{workspaceRoot}/apps/auth-service/dist/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/apps/auth-service/dist/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "@clarte/auth-service:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "@clarte/auth-service:build:development"
        },
        "production": {
          "buildTarget": "@clarte/auth-service:build:production"
        }
      }
    },
    "generate-keys": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{workspaceRoot}/apps/auth-service/src/assets/private.key",
        "{workspaceRoot}/apps/auth-service/src/assets/public.key"
      ],
      "options": {
        "commands": [
          "mkdir -p src/assets",
          "openssl genrsa -out src/assets/private.key 2048",
          "openssl rsa -in src/assets/private.key -pubout -out src/assets/public.key"
        ],
        "cwd": "apps/auth-service",
        "parallel": false
      }
    }
  }
}

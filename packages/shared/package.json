{
  "name": "@clarte/shared",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@clarte/source": "./src/index.ts",
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./functions": {
      "@clarte/source": "./src/functions/index.ts",
      "types": "./dist/cjs/functions/index.d.ts",
      "import": "./dist/esm/functions/index.js",
      "require": "./dist/cjs/functions/index.js",
      "default": "./dist/cjs/functions/index.js"
    }
  },
  "dependencies": {
    "@swc/helpers": "catalog:swc",
    "radash": "catalog:general",
    "type-fest": "catalog:types"
  }
}

{
  "$schema": "https://raw.githubusercontent.com/nrwl/nx/master/packages/nx/schemas/project-schema.json",
  "name": "@clarte/shared",
  "root": "packages/shared",
  "projectType": "library",
  "tags": ["scope:shared", "type:lib"],
  "sourceRoot": "packages/shared/src",
  "targets": {
    "build-cjs": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/shared/dist/cjs",
        "main": "packages/shared/src/index.ts",
        "tsConfig": "packages/shared/tsconfig.lib.json",
        "swcrc": "packages/shared/.swcrc.cjs.json",
        "skipTypeCheck": true,
        "stripLeadingPaths": true
      }
    },
    "build-esm": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/shared/dist/esm",
        "main": "packages/shared/src/index.ts",
        "tsConfig": "packages/shared/tsconfig.lib.json",
        "swcrc": "packages/shared/.swcrc.esm.json",
        "skipTypeCheck": true,
        "stripLeadingPaths": true
      }
    },
    "build": {
      "executor": "nx:noop",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/shared/dist/cjs"
      },
      "dependsOn": ["build-cjs", "build-esm"]
    }
  }
}

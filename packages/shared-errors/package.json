{
  "name": "@clarte/shared-errors",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@clarte/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./domain": {
      "@clarte/source": "./src/domain/index.ts",
      "types": "./dist/domain/index.d.ts",
      "import": "./dist/domain/index.js",
      "default": "./dist/domain/index.js"
    },
    "./grpc": {
      "@clarte/source": "./src/grpc/index.ts",
      "types": "./dist/grpc/index.d.ts",
      "import": "./dist/grpc/index.js",
      "default": "./dist/grpc/index.js"
    },
    "./http": {
      "@clarte/source": "./src/http/index.ts",
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "default": "./dist/http/index.js"
    },
    "./mappers": {
      "@clarte/source": "./src/mappers/index.ts",
      "types": "./dist/mappers/index.d.ts",
      "import": "./dist/mappers/index.js",
      "default": "./dist/mappers/index.js"
    },
    "./classes": {
      "@clarte/source": "./src/classes/index.ts",
      "types": "./dist/classes/index.d.ts",
      "import": "./dist/classes/index.js",
      "default": "./dist/classes/index.js"
    }
  },
  "nx": {
    "sourceRoot": "packages/shared-errors/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/shared-errors/dist",
          "main": "packages/shared-errors/src/index.ts",
          "tsConfig": "packages/shared-errors/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true,
          "swcrc": "packages/shared-errors/.swcrc"
        },
        "configurations": {
          "production": {
            "swcrc": "packages/shared-errors/.swcrc.prod"
          }
        }
      }
    }
  },
  "dependencies": {
    "@swc/helpers": "catalog:swc"
  }
}

{
  "$schema": "https://raw.githubusercontent.com/nrwl/nx/master/packages/nx/schemas/project-schema.json",
  "name": "@clarte/user-service",
  "root": "apps/user-service",
  "projectType": "application",
  "tags": ["scope:user", "type:app"],
  "targets": {
    "build": {
      "cache": true,
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "apps/user-service/dist",
        "main": "apps/user-service/src/main.ts",
        "tsConfig": "apps/user-service/tsconfig.app.json",
        "skipTypeCheck": true,
        "assets": [
          {
            "input": "packages/shared-contracts/src/ports/proto",
            "glob": "**/*.proto",
            "output": "proto"
          }
        ]
      },
      "configurations": {
        "production": {
          "swcrc": "apps/user-service/.swcrc.prod",
          "skipTypeCheck": true
        },
        "development": {
          "swcrc": "apps/user-service/.swcrc"
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/apps/user-service/dist/package.json",
        "{workspaceRoot}/apps/user-service/dist/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/apps/user-service/dist/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "@clarte/user-service:build",
        "runBuildTargetDependencies": false,
        "inspect": false
      },
      "configurations": {
        "development": {
          "buildTarget": "@clarte/user-service:build:development"
        },
        "production": {
          "buildTarget": "@clarte/user-service:build:production"
        }
      }
    },
    "compose-infra-up": {},
    "compose-infra-down": {},
    "compose-infra-logs": {}
  }
}
